{
  "name": "@local/session-delete",
  "version": "1.0.0",
  "private": true,
  "description": "Delete a DeepSeek Harness session's stored log from disk, from the session row menu.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "bundle",
    "session",
    "delete"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lsc-91-69/dsh-session-delete.git"
  },
  "homepage": "https://github.com/Lsc-91-69/dsh-session-delete#readme",
  "bugs": {
    "url": "https://github.com/Lsc-91-69/dsh-session-delete/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "README.zh.md"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-context-menu",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
